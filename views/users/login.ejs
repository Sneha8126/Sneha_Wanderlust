<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <!-- Mobile par col-10, offset-1; Desktop par col-6, offset-3 -->
    <div class="col-10 col-md-6 offset-1 offset-md-3">
        <h1 class="mb-3">Login</h1>
        <form action="/login" method="POST" class="needs-validation" novalidate> 
            
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input name="username" id="username" type="text" class="form-control" required/>
                <div class="invalid-feedback">Please enter your username</div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <div class="input-group">
                    <input type="password" name="password" id="password" class="form-control" required>
                    <button class="btn btn-outline-secondary" type="button" id="loginPasswordToggle">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
            </div>

            <button class="btn btn-danger w-100 mb-2">Login</button>
            <a href="/forgot" class="d-block text-danger text-decoration-none small mb-3">Forgot Password?</a>
            
            <p class="text-muted small">
                Don't have an account? 
                <a href="/signup" class="text-danger text-decoration-underline fw-bold">Register here</a>
            </p>
        </form>
    </div>
</div>

<script>
    document.getElementById("loginPasswordToggle").addEventListener("click", function() {
        const passwordInput = document.getElementById("password");
        const icon = this.querySelector("i");
        
        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            icon.classList.replace("fa-eye", "fa-eye-slash");
        } else {
            passwordInput.type = "password";
            icon.classList.replace("fa-eye-slash", "fa-eye");
        }
    });
</script>